# Copy to .env and fill in. The real .env is gitignored, and the ignore rules
# cover `.env` itself rather than only `.env.*.local`: the upstream fork's rules
# did not, which is how it ended up tracking one.

# Supabase project the web app talks to.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Origin of the FastAPI service, which the /vat screen calls directly. The
# deployed value is printed by scripts/deploy-api.sh, and the same origin must
# appear in connect-src (apps/web/index.html and apps/web/public/_headers): a
# browser refuses a call the CSP does not name, and it refuses it silently.
VITE_API_URL=https://vega-api.fly.dev

# Service-role key. Never referenced from apps/web. Edge functions and scripts
# only, and only the ones that genuinely cannot act as the caller.
SUPABASE_SERVICE_ROLE_KEY=# The API service connects with its own non-owning role, never the key above.
# See SECURITY.md N2.
VEGA_DATABASE_URL=

# Browser origins allowed to call the API service, comma separated. The web app
# is a separate origin, so its calls are preflighted: a browser will not send
# the Authorization and X-Vega-Company headers unless the service answers the
# preflight naming the web origin, and it refuses silently when it does not.
# Set the deployed web origin here when the web deploys. Unset means the Vite
# dev server (http://localhost:8080) only.
VEGA_CORS_ORIGINS=http://localhost:8080

# getAddress.io key for postcode lookup on address entry. Free tier: 20
# lookups a day. Held only by the API service; never sent to the browser.
#
# Optional. Left blank or unset, the service still starts and every other
# endpoint works; the postcode route answers 503 saying it is not configured,
# and addresses can still be typed in.
GETADDRESS_API_KEY=

# HMRC Making Tax Digital. Register an application at the HMRC Developer Hub to
# get these; nobody has yet, and the service starts and runs without them.
# Only the VAT submission routes need them, and they say so when unset.
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=
# sandbox or production. Leave as sandbox until a real filing is intended.
HMRC_ENVIRONMENT=sandbox

# Encrypts HMRC tokens before they reach the database, so a stolen backup is
# useless on its own. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# There is no default: a default key is the same as no encryption.
VEGA_TOKEN_KEY=
